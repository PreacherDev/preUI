{
  "name": "@pre_scripts/preui-nui",
  "version": "0.1.0",
  "description": "FiveM NUI helpers for preUI: fetchNui, NUI message hooks, browser mocks and a live theme bridge",
  "keywords": ["fivem", "nui", "cfx", "react", "preui", "theme"],
  "author": "PRE_SCRIPTS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreacherDev/preUI-0.0.1.git",
    "directory": "packages/preui-nui"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/preui-nui",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@pre_scripts/preui": ">=0.5.0",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
