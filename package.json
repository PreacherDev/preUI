        "types": "./dist/code.d.ts",
        "default": "./dist/code.js"
      },
      "require": {
        "types": "./dist/code.d.cts",
        "default": "./dist/code.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/markdown.d.ts",
        "default": "./dist/markdown.js"
      },
      "require": {
        "types": "./dist/markdown.d.cts",
        "default": "./dist/markdown.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.js"
      },
      "require": {
        "types": "./dist/editor.d.cts",
        "default": "./dist/editor.cjs"
      }
    },
    "./icons/lucide": {
      "import": {
        "types": "./dist/icons/lucide.d.ts",
        "default": "./dist/icons/lucide.js"
      },
      "require": {
        "types": "./dist/icons/lucide.d.cts",
        "default": "./dist/icons/lucide.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind.d.ts",
        "default": "./dist/tailwind.js"
      },
      "require": {
        "types": "./dist/tailwind.d.cts",
        "default": "./dist/tailwind.cjs"
      }
    },
    "./fonts.css": "./dist/fonts.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown && node scripts/patch-tailwind-cjs.mjs && node scripts/generate-tokens.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
