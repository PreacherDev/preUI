{
  "name": "@pre_scripts/preui",
  "version": "0.4.1",
  "description": "React UI components built on Base UI and Tailwind CSS v3",
  "keywords": [
    "react",
    "ui",
    "components",
    "component-library",
    "tailwind",
    "tailwindcss",
    "typescript",
    "base-ui",
    "headless",
    "dark-theme",
    "shadcn",
    "recharts",
    "markdown",
    "rich-text",
    "code-editor",
    "syntax-highlighting"
  ],
  "author": "PRE_SCRIPTS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreacherDev/preUI-0.0.1.git"
  },
  "homepage": "https://github.com/PreacherDev/preUI-0.0.1#readme",
  "bugs": {
    "url": "https://github.com/PreacherDev/preUI-0.0.1/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "preui": "./bin/preui.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chart": {
      "import": {
        "types": "./dist/chart.d.ts",
        "default": "./dist/chart.js"
      },
      "require": {
        "types": "./dist/chart.d.cts",
        "default": "./dist/chart.cjs"
      }
    },
