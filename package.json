      }
    },
    "./carousel": {
      "import": {
        "types": "./dist/carousel.d.ts",
        "default": "./dist/carousel.js"
      },
      "require": {
        "types": "./dist/carousel.d.cts",
        "default": "./dist/carousel.cjs"
      }
